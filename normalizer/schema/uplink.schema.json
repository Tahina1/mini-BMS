{
  "$id": "uplink",
  "type": "object",
  "required": ["devEui", "fCnt", "fPort", "data", "time", "rxInfo"],
  "properties": {
    "devEui": { "type": "string", "pattern": "^[0-9A-Fa-f]{16}$" },
    "fCnt":   { "type": "integer", "minimum": 0 },
    "fPort":  { "type": "integer", "minimum": 1, "maximum": 223 },
    "data":   { "type": "string" },
    "time":   { "type": "string", "format": "date-time" },
    "rxInfo": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["gatewayId", "rssi", "snr"],
        "properties": {
          "gatewayId": { "type": "string" },
          "rssi": { "type": "integer" },
          "snr":  { "type": "number" }
        }
      }
    }
  }
}